rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSystemAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserRole() == 'system_admin';
    }

    function isAnyAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserRole() == 'system_admin' || getUserRole() == 'barangay_admin');
    }

    // =============================================
    // USERS COLLECTION
    // =============================================
    match /users/{userId} {

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.verified == false
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['resident', 'barangay_admin'];

      allow get: if isOwner(userId) || isAnyAdmin();

      allow list: if isAnyAdmin();

      allow update: if
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'requestedRole', 'status', 'position', 'permissions',
          'verified', 'verificationStatus', 'verificationNotes', 'verifiedBy', 'verifiedAt',
          'barangayId', 'barangayName', 'barangayMunicipality', 'barangayProvince',
          'currentlyReviewedBy', 'reviewStartedAt', 'approvedBy', 'approvedAt',
          'termStart', 'termEnd'
        ])) || isAnyAdmin();

      allow delete: if isSystemAdmin();

      match /terms/{termId} {
        allow read: if isOwner(userId) || isAnyAdmin();
        allow create: if isAnyAdmin();
        allow update, delete: if false;
      }
    }

    // =============================================
    // BARANGAYS COLLECTION
    // =============================================
    match /barangays/{barangayId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isSystemAdmin();
    }

    // =============================================
    // AUDIT LOGS (IMMUTABLE)
    // =============================================
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAnyAdmin();
      allow update, delete: if false;
    }

    // =============================================
    // NOTIFICATIONS
    // =============================================
    match /notifications/{notifId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == resource.data.targetUid;
      allow delete: if false;
    }

    // =============================================
    // SESSIONS
    // =============================================
    match /sessions/{sessionId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
